# shared-pg-stack secrets + per-node PG tuning. Copy to .env and set strong values.

# Superuser password for the shared Postgres. The master runs DDL via
# `docker exec shared-postgres psql -U postgres` (local socket = trust = passwordless),
# so this is only a safety net for any TCP superuser access. Keep it strong regardless.
PG_SUPERPASS=CHANGE_ME_STRONG

# Password for the low-priv pgbouncer_auth role (PgBouncer auth_query). ALPHANUMERIC ONLY
# (it is inserted into SQL and the userlist as a literal). Must match on both containers
# (they read the same .env), so set it once here.
AUTH_PASS=CHANGE_ME_ALNUM

# --- Per-node Postgres tuning (size to THIS node; shared_buffers ~25% of node RAM) ---
# Defaults are conservative so the stack boots on a small test node. step_saas_shared_pg
# writes the three memory keys from /proc/meminfo on first deploy and ONLY when the key
# is absent, so a value you set by hand here survives every later run.
# 🔴 PG_MAX_CONNECTIONS is the input to the CAPACITY BUDGET at the top of pgbouncer.ini.
# Lowering it, or raising the pool ceilings without raising it, oversubscribes the
# cluster — which is how the 2026-09-28 fleet-wide login outage happened.
# tests/test_proxy_and_pool.sh asserts the arithmetic; keep both files in step.
#PG_MAX_CONNECTIONS=500
#PG_SUPERUSER_RESERVED=10
#PG_SHARED_BUFFERS=8GB
#PG_EFFECTIVE_CACHE_SIZE=24GB
#PG_WORK_MEM=16MB
#PG_MAINTENANCE_WORK_MEM=1GB

# --- Planner (defaults already assume NVMe/SSD; raise only on spinning disks) ---
#PG_RANDOM_PAGE_COST=1.1
#PG_EFFECTIVE_IO_CONCURRENCY=200

# --- Logging (on by default: there was no forensic trail during the outage) ---
# log_statement=ddl catches tenant provisioning and module installs; never use `all`.
#PG_LOG_MIN_DURATION=1000
#PG_LOG_STATEMENT=ddl
#PG_LOG_CONNECTIONS=on
#PG_LOG_DISCONNECTIONS=on
#PG_LOG_LOCK_WAITS=on
#PG_LOG_TEMP_FILES=8MB
#PG_LOG_AUTOVACUUM_MIN_DURATION=10s
#PG_LOG_TIMEZONE=UTC
#PG_TRACK_ACTIVITY_QUERY_SIZE=4096
# Docker-side rotation. Without it, logging on is a disk-full outage.
#PG_LOG_MAX_SIZE=50m
#PG_LOG_MAX_FILE=5
#PGBOUNCER_LOG_MAX_SIZE=50m
#PGBOUNCER_LOG_MAX_FILE=5

# --- Dead-peer detection + leak bounds ---
#PG_TCP_KEEPALIVES_IDLE=60
#PG_TCP_KEEPALIVES_INTERVAL=10
#PG_TCP_KEEPALIVES_COUNT=6
# 🔴 Do NOT add idle_session_timeout anywhere: it would kill the two permanent
# LISTEN sessions every tenant holds on the `postgres` database.
#PG_IDLE_IN_TXN_TIMEOUT=900000

# --- File descriptors / shared memory ---
# The inherited soft limit is 1024, which caps the whole node at ~500 PgBouncer clients
# and fails as "accept(): Too many open files" with no hint about fds.
#PG_NOFILE=65536
#PGBOUNCER_NOFILE=65536
#PG_SHM_SIZE=1gb
